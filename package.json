{
  "name": "commit-generater",
  "displayName": "Commit Generater",
  "description": "AI-powered Git commit message generator using OpenAI-compatible APIs",
  "version": "1.1.1",
  "publisher": "hKFirEs",
  "license": "MIT",
  "icon": "resources/icon.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/hkfires/CommitGenerater"
  },
  "homepage": "https://github.com/hkfires/CommitGenerater#readme",
  "bugs": {
    "url": "https://github.com/hkfires/CommitGenerater/issues"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "openai",
    "conventional-commits",
    "scm"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "commit-generater-icon": {
        "description": "Commit Generater icon",
        "default": {
          "fontPath": "./resources/commit-generater-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "commands": [
      {
        "command": "commitGenerater.generate",
        "title": "Generate Commit Message",
        "icon": {
          "light": "resources/icon-light.svg",
          "dark": "resources/icon-dark.svg"
        },
        "category": "Commit Generater"
      },
      {
        "command": "commitGenerater.selectModel",
        "title": "Select AI Model",
        "category": "Commit Generater"
      },
      {
        "command": "commitGenerater.selectReasoningEffort",
        "title": "Select Reasoning Effort",
        "category": "Commit Generater"
      },
      {
        "command": "commitGenerater.openSettings",
        "title": "Settings",
        "icon": "$(gear)",
        "category": "Commit Generater"
      },
      {
        "command": "commitGenerater.setup",
        "title": "Setup Wizard",
        "category": "Commit Generater"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitGenerater.generate",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Commit Generater",
      "properties": {
        "commitGenerater.apiBaseUrl": {
          "scope": "machine",
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for OpenAI-compatible APIs (no trailing slash)"
        },
        "commitGenerater.apiKey": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "API Key"
        },
        "commitGenerater.model": {
          "scope": "machine",
          "type": "string",
          "default": "gpt-5",
          "description": "Model name. Use the `Select AI Model` command (or the status bar item) to pick from the API's /models list, or type any name here"
        },
        "commitGenerater.reasoningEffort": {
          "scope": "machine",
          "type": "string",
          "enum": [
            "default",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumItemLabels": [
            "Default",
            "None",
            "Minimal",
            "Low",
            "Medium",
            "High",
            "XHigh",
            "Max"
          ],
          "enumDescriptions": [
            "Do not send reasoning_effort (use the provider default)",
            "Disable reasoning",
            "Minimal reasoning",
            "Low reasoning effort",
            "Medium reasoning effort",
            "High reasoning effort",
            "Extra high reasoning effort",
            "Maximum reasoning effort"
          ],
          "default": "default",
          "description": "Reasoning effort (reasoning_effort) sent to the model"
        },
        "commitGenerater.language": {
          "scope": "machine",
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh"
          ],
          "enumItemLabels": [
            "Auto",
            "English",
            "中文"
          ],
          "enumDescriptions": [
            "Detect from recent commit history; falls back to the VS Code display language for repositories without commits",
            "English",
            "Chinese"
          ],
          "default": "auto",
          "description": "Language for generated commit messages and pull request titles/descriptions"
        },
        "commitGenerater.includeAgentsMd": {
          "scope": "machine",
          "type": "boolean",
          "default": true,
          "description": "Include AGENTS.md from the repository root as project guidelines when generating commit messages and pull request titles/descriptions"
        },
        "commitGenerater.maxDiffLength": {
          "scope": "machine",
          "type": "number",
          "default": 131072,
          "description": "Maximum diff length (characters) sent to the AI"
        },
        "commitGenerater.prTitleProvider": {
          "scope": "machine",
          "type": "string",
          "enum": [
            "ask",
            "commitGenerater",
            "copilot"
          ],
          "enumItemLabels": [
            "Ask",
            "CommitGenerater",
            "Copilot"
          ],
          "enumDescriptions": [
            "Ask which generator to use each time",
            "Always use Commit Generater",
            "Always use GitHub Copilot"
          ],
          "default": "ask",
          "markdownDescription": "Generator used by the ✨ button next to the title in the Create Pull Request view of the [GitHub Pull Requests](https://marketplace.visualstudio.com/items?itemName=GitHub.vscode-pull-request-github) extension"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
